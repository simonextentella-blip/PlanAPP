{
  "expo": {
    "name": "PlanApp",
    "slug": "planapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.planapp.app",
      "infoPlist": {
        "NSContactsUsageDescription": "PlanApp usa i contatti per importare nome e telefono di un cliente."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.planapp.app",
      "blockedPermissions": [
        "android.permission.WRITE_CONTACTS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "name": "PlanApp",
      "shortName": "PlanApp",
      "lang": "it",
      "themeColor": "#2F3E2F",
      "backgroundColor": "#F4F5F2"
    },
    "plugins": [
      [
        "expo-router",
        {
          "asyncRoutes": false
        }
      ],
      "expo-sharing",
      [
        "expo-contacts",
        {
          "contactsPermission": "PlanApp usa i contatti per importare nome e telefono di un cliente."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "PlanApp usa le foto per allegarle ai sopralluoghi.",
          "cameraPermission": "PlanApp usa la fotocamera per scattare le foto dei sopralluoghi.",
          "microphonePermission": false
        }
      ]
    ],
    "scheme": "planapp",
    "experiments": {
      "baseUrl": "/PlanAPP"
    }
  }
}
